# ==============================================================================
# DROP by LocalReach - Environment Configuration Template
# ==============================================================================
# Server-side environment variables (Configure in Vercel Dashboard / backend/.env)
# Do NOT prefix server variables with VITE_ to prevent leaking them to the client.

# Server Port & Environment
PORT=5000
NODE_ENV=development

# MongoDB Atlas Database Connection
MONGODB_URI=

# Storage Provider: 'b2' for Backblaze B2 (production) or 'local' for local development fallback
STORAGE_PROVIDER=b2

# Backblaze B2 (S3-Compatible Storage)
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_BUCKET_NAME=drop-localreach-storage
B2_KEY_ID=
B2_APPLICATION_KEY=

# Upstash Redis Credentials (for distributed rate limiting and temporary upload reservations)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Cron Secret (protects /api/cron/cleanup from unauthorized execution)
CRON_SECRET=

# Cryptographic token secret for HMAC signing
TOKEN_SECRET=

# File Drop Lifecycle Limits
FILE_EXPIRATION_DAYS=10
MAX_FILE_SIZE_MB=100

# Allowed CORS Origins (comma-separated if multiple)
CORS_ORIGIN=http://localhost:5173,https://drop.localreach.in

# Public Base URL for generated drop links
PUBLIC_BASE_URL=https://drop.localreach.in

# Contact Information
CONTACT_EMAIL=contact@localreach.in
CONTACT_URL=https://localreach.in/contact

# ==============================================================================
# Frontend Environment Variables (Configure in frontend/.env / Vercel Dashboard)
# ==============================================================================
# In production on Vercel, leave empty or set to /api for same-origin routing
VITE_API_URL=/api
